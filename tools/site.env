# Site settings, as KEY=VALUE lines. No build script sources this file on its own:
# load it into the shell first with   set -a; . tools/site.env; set +a
#
# Public URL of the site. The absolute URLs in index.html (canonical, og:url,
# og:image, JSON-LD), robots.txt, sitemap.xml and the BibTeX url are written out by
# hand; change all of them together with this line (see README, "If the repo or URL changes").
BASE_URL=https://skymanaditya1.github.io/proxy-website/

# Evaluation-video archive (7.1 GB, not in git) read by tools/build_media.py.
# Relative to the website root; build_media.py falls back to <root>/proxy_videos.zip
# when the variable is unset.
PROXY_VIDEOS_ZIP=./proxy_videos.zip
